# Copy to server/.env and fill in. server/.env is NEVER committed to Git (see .gitignore).

# Port of the API server
PORT=5001
# production | staging | test (shown in /api/health)
APP_ENV=production
# Folder of floorplan.db (default: server/data). Staging uses .staging/data
# DATA_DIR=
# Extra web origins allowed by CORS, comma separated (localhost is always allowed)
# ALLOWED_ORIGINS=https://denah.contoh.com
# Salt for the anonymous exhibitor alias on the Live Floorplan (random text; keep it stable)
# PUBLIC_ALIAS_SALT=

# Backup (AGENTS.md §21)
# BACKUP_DIR=
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_OTHER=90
# BACKUP_DISABLED=0

# Claude API for the maintenance agent (Pusat Maintenance). Server only: never in client code, never logged.
# Usually set from the admin: Setting > Integrasi AI (Claude), Super Admin only (written here with mode 600).
ANTHROPIC_API_KEY=
# Model name, chosen from GET https://api.anthropic.com/v1/models
ANTHROPIC_MODEL=
# Base URL of the Claude API (default https://api.anthropic.com; tests use a local mock)
# ANTHROPIC_API_URL=
# Other .env file to load / write instead of server/.env (tests)
# ENV_FILE=

# Invoice PDF (AGENTS.md §34). All optional.
# Chromium / Chrome binary when it is not at a standard path (/usr/bin/chromium, Google Chrome on macOS...)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Where the print route is opened (default: this server itself)
# PRINT_BASE_URL=http://127.0.0.1:5001
# Keeps registrants' PDF download links valid across restarts (default: random per start, links last 2 hours)
# PDF_TOKEN_SECRET=
